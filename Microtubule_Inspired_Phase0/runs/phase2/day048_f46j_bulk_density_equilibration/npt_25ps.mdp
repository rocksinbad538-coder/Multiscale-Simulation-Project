integrator  = md
dt          = 0.0005
nsteps      = 50000

nstxout-compressed = 1000
nstenergy   = 500
nstlog      = 500

cutoff-scheme = Verlet
nstlist     = 20
rlist       = 1.2

coulombtype = PME
rcoulomb    = 1.2

vdwtype     = Cut-off
rvdw        = 1.2

pbc         = xyz
constraints = none

tcoupl      = V-rescale
tc-grps     = System
tau_t       = 1.0
ref_t       = 300

pcoupl      = C-rescale
pcoupltype  = isotropic
tau_p       = 5.0
ref_p       = 1.0
compressibility = 4.5e-5

comm-mode   = Linear

continuation = yes
gen_vel      = no
