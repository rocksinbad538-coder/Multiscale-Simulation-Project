; Day021 mobile-release protocol
; Derived from runs/phase1A/accepted/hybrid_hydrated_gap45_pyr5shift_clean032_nvt_100ps_frozenSolute/nvt_100ps_frozenSolute.mdp
; Accepted source files were not modified

cutoff-scheme                = Verlet
nstlist                      = 20
rlist                        = 1.2
coulombtype                  = PME
rcoulomb                     = 1.2
vdwtype                      = Cut-off
rvdw                         = 1.2
pbc                          = xyz
constraints                  = none
tc-grps                      = System
tau-t                        = 1.0
ref-t                        = 300

; Day023 R1 water-only minimization overrides
integrator               = steep
emtol                    = 500.0
emstep                   = 0.001000
nsteps                   = 50000
continuation             = no
define                   =
freezegrps               = HBN_PYR CAPS
freezedim                = Y Y Y Y Y Y
gen_vel                  = no
tcoupl                   = no
pcoupl                   = no
comm_mode                = none
energygrps               = HBN_PYR SOL CAPS
nstcalcenergy            = 10
nstenergy                = 10
nstlog                   = 10
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout_compressed       = 0
