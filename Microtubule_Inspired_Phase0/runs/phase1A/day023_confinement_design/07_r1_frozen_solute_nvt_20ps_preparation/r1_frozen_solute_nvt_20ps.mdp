; Day021 mobile-release protocol
; Derived from runs/phase1A/accepted/hybrid_hydrated_gap45_pyr5shift_clean032_nvt_100ps_frozenSolute/nvt_100ps_frozenSolute.mdp
; Accepted source files were not modified

cutoff-scheme                = Verlet
nstlist                      = 20
rlist                        = 1.2
coulombtype                  = PME
rcoulomb                     = 1.2
vdwtype                      = Cut-off
rvdw                         = 1.2
pbc                          = xyz
constraints                  = none

; Day023 R1 frozen-solute 20 ps screening
integrator               = md
dt                       = 0.0005000
nsteps                   = 40000
tinit                    = 0.0
init-step                = 0
continuation             = no
define                   =

freezegrps               = HBN_PYR CAPS
freezedim                = Y Y Y Y Y Y

tcoupl                   = V-rescale
tc-grps                  = SOL HBN_PYR CAPS
tau-t                    = 0.100 -1 -1
ref-t                    = 300.0 300.0 300.0
pcoupl                   = no

gen-vel                  = yes
gen-temp                 = 300.0
gen-seed                 = 20260708

comm-mode                = Linear
comm-grps                = SOL
nstcomm                  = 100

energygrps               = HBN_PYR SOL CAPS
nstcalcenergy            = 100
nstenergy                = 100
nstlog                   = 100
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 1000
compressed-x-precision   = 1000
