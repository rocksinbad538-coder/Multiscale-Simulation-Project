000068: def load_module(path: Path, name: str):
000069:     if not path.is_file():
000070:         raise RuntimeError(f"Missing helper module: {path}")
000071:     spec = importlib.util.spec_from_file_location(name, path)
000072:     if spec is None or spec.loader is None:
000073:         raise RuntimeError(f"Could not load helper module: {path}")
000074:     module = importlib.util.module_from_spec(spec)
000075:     spec.loader.exec_module(module)
000076:     return module
000077: 
000078: 
000079: def require_file(path: Path) -> None:
000080:     if not path.is_file() or path.stat().st_size == 0:
000081:         raise RuntimeError(f"Missing or empty required file: {path}")
000082: 
000083: 
000084: def read_rows(path: Path) -> list[dict[str, str]]:
000085:     require_file(path)
000086:     with path.open(newline="", encoding="utf-8") as handle:
000087:         rows = list(csv.DictReader(handle))
000088:     if not rows:
000089:         raise RuntimeError(f"No rows found in {path}")
000090:     return rows
000091: 
000092: 
000093: def read_one(path: Path) -> dict[str, str]:
000094:     rows = read_rows(path)
000095:     if len(rows) != 1:
000096:         raise RuntimeError(f"Expected one row in {path}; found {len(rows)}")
000097:     return rows[0]
000098: 
000099: 
000100: def write_rows(path: Path, rows: list[dict[str, Any]]) -> None:
000101:     if not rows:
000102:         raise RuntimeError(f"No rows available for {path}")
000103:     fields: list[str] = []
000104:     for row in rows:
000105:         for key in row:
000106:             if key not in fields:
000107:                 fields.append(key)
000108:     with path.open("w", newline="", encoding="utf-8") as handle:
000109:         writer = csv.DictWriter(handle, fieldnames=fields)
000110:         writer.writeheader()
000111:         for row in rows:
000112:             writer.writerow({field: row.get(field, "") for field in fields})
