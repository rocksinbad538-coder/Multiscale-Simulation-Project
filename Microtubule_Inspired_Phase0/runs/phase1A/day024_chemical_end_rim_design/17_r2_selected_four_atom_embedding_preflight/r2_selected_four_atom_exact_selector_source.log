   138	def normalized_batch(vectors: np.ndarray) -> np.ndarray:
   139	    norms = np.linalg.norm(vectors, axis=1)
   140	    if np.any(norms <= 1.0e-12):
   141	        raise RuntimeError("Zero vector in batch normalization.")
   142	    return vectors / norms[:, None]
   143	
   144	
   145	def place_next_batch(
   146	    first: np.ndarray,
   147	    second: np.ndarray,
   148	    third: np.ndarray,
   149	    angle_rad: np.ndarray,
   150	    torsion_rad: np.ndarray,
   151	) -> np.ndarray:
   152	    previous = normalized_batch(third - second)
   153	    normal = np.cross(second - first, previous)
   154	    bad = np.linalg.norm(normal, axis=1) <= 1.0e-12
   155	    if np.any(bad):
   156	        reference = np.tile(np.asarray([0.0, 0.0, 1.0]), (int(np.sum(bad)), 1))
   157	        previous_bad = previous[bad]
   158	        parallel = np.abs(np.sum(previous_bad * reference, axis=1)) > 0.90
   159	        reference[parallel] = np.asarray([0.0, 1.0, 0.0])
   160	        normal[bad] = np.cross(previous_bad, reference)
   161	    normal = normalized_batch(normal)
   162	    in_plane = normalized_batch(np.cross(normal, previous))
   163	    direction = (
   164	        -np.cos(angle_rad)[:, None] * previous
   165	        + np.sin(angle_rad)[:, None]
   166	        * (
   167	            np.cos(torsion_rad)[:, None] * in_plane
   168	            + np.sin(torsion_rad)[:, None] * normal
   169	        )
   170	    )
   171	    return third + BN * direction
   172	
