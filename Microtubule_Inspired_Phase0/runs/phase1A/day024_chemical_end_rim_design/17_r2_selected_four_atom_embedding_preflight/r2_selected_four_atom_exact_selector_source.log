   211	def map_chain_generic(
   212	    chain: np.ndarray,
   213	    start: np.ndarray,
   214	    finish: np.ndarray,
   215	    azimuth_deg: float,
   216	    mirror: bool,
   217	    geometry,
   218	) -> np.ndarray:
   219	    working = np.array(chain, dtype=float, copy=True)
   220	    if mirror:
   221	        working[:, 2] *= -1.0
   222	    target = finish - start
   223	    alignment = geometry.rotation_from_vectors(working[-1] - working[0], target)
   224	    mapped = (working - working[0]) @ alignment.T
   225	    mapped = mapped @ geometry.rotation_about_axis(
   226	        geometry.normalized(target),
   227	        math.radians(azimuth_deg),
   228	    ).T
   229	    correction = target - mapped[-1]
   230	    denominator = mapped.shape[0] - 1
   231	    for index in range(1, mapped.shape[0]):
   232	        mapped[index] += (index / denominator) * correction
   233	    mapped += start
   234	    return mapped
   235	

