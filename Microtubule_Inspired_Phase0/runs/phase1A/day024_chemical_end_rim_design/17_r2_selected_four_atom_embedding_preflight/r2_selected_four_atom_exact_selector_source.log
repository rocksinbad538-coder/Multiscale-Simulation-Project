   257	def soft_penalty(distances: np.ndarray) -> float:
   258	    return float(
   259	        np.sum(np.maximum(SOFT_HEAVY_CLEARANCE_NM - distances, 0.0) ** 2)
   260	    )
   261	
   262	
   263	def evaluate_chain(
   264	    chain: np.ndarray,
   265	    start_neighbors: list[np.ndarray],
   266	    finish_neighbors: list[np.ndarray],
   267	    local_fixed: np.ndarray,
   268	    geometry,
   269	) -> dict[str, Any]:
   270	    bonds = np.linalg.norm(np.diff(chain, axis=0), axis=1)
   271	    max_bond_deviation = float(np.max(np.abs(bonds - BN)))
   272	    angles = [
   273	        geometry.angle_degrees(chain[index - 1], chain[index], chain[index + 1])
   274	        for index in range(1, chain.shape[0] - 1)
   275	    ]
   276	    angles.extend(
   277	        geometry.angle_degrees(neighbor, chain[0], chain[1])
   278	        for neighbor in start_neighbors
   279	    )
   280	    angles.extend(
   281	        geometry.angle_degrees(neighbor, chain[-1], chain[-2])
   282	        for neighbor in finish_neighbors
   283	    )
   284	    angle_values = np.asarray(angles, dtype=float)
   285	    angle_violations = int(
   286	        np.sum(
   287	            (angle_values < ANGLE_MIN_GATE_DEG)
   288	            | (angle_values > ANGLE_MAX_GATE_DEG)
   289	        )
   290	    )
   291	    self_distances = []
   292	    for first in range(chain.shape[0]):
   293	        for second in range(first + 2, chain.shape[0]):
   294	            self_distances.append(float(np.linalg.norm(chain[first] - chain[second])))
   295	    internal = chain[1:-1]
   296	    fixed_distances = (
   297	        np.linalg.norm(
   298	            internal[:, None, :] - local_fixed[None, :, :],
   299	            axis=2,
   300	        ).reshape(-1)
   301	        if local_fixed.size
   302	        else np.asarray([], dtype=float)
   303	    )
   304	    nonbonded = np.concatenate((np.asarray(self_distances), fixed_distances))
   305	    clashes = int(np.sum(nonbonded < MIN_HEAVY_CLEARANCE_NM))
   306	    minimum_clearance = float(np.min(nonbonded))
   307	    passes = (
   308	        angle_violations == 0
   309	        and clashes == 0
   310	        and max_bond_deviation <= MAX_BOND_DEVIATION_NM
   311	    )
   312	    return {
   313	        "passes": passes,
   314	        "angle_violations": angle_violations,
   315	        "minimum_angle_deg": float(np.min(angle_values)),
   316	        "maximum_angle_deg": float(np.max(angle_values)),
   317	        "maximum_bond_deviation_nm": max_bond_deviation,
   318	        "clash_count": clashes,
   319	        "minimum_clearance_nm": minimum_clearance,
   320	        "clearance_penalty": soft_penalty(nonbonded),
   321	    }
   322	
   323	
   324	def local_score(candidate: dict[str, Any]) -> tuple[Any, ...]:
   325	    return (
   326	        int(candidate["clash_count"]),
   327	        int(candidate["angle_violations"]),
   328	        float(candidate["clearance_penalty"]),
   329	        -float(candidate["minimum_angle_deg"]),
   330	        -float(candidate["minimum_clearance_nm"]),
   331	        float(candidate["maximum_bond_deviation_nm"]),
   332	        float(candidate["library_distance_error_nm"]),
   333	    )
