   425	    def screen_pair(end: str, bridge_atoms: int, seed_id: str, annulus_id: str) -> dict[str, Any]:
   426	        key = (end, bridge_atoms, seed_id, annulus_id)
   427	        if key in pair_cache:
   428	            return pair_cache[key]
   429	        start = coordinates[seed_id]
   430	        finish = coordinates[annulus_id]
   431	        start_neighbors = [coordinates[node_id] for node_id in base_adjacency[seed_id]]
   432	        finish_neighbors = [coordinates[node_id] for node_id in base_adjacency[annulus_id]]
   433	        if len(start_neighbors) != 2 or len(finish_neighbors) != 2:
   434	            raise RuntimeError(f"{key}: endpoint base-heavy neighbors are not 2/2.")
   435	        midpoint = 0.5 * (start + finish)
   436	        local_ids = [
   437	            node_id
   438	            for node_id in fixed_heavy_ids
   439	            if node_id not in {seed_id, annulus_id}
   440	            and float(np.linalg.norm(coordinates[node_id] - midpoint)) <= LOCAL_RADIUS_NM
   441	        ]
   442	        local_fixed = (
   443	            np.asarray([coordinates[node_id] for node_id in local_ids], dtype=float)
   444	            if local_ids
   445	            else np.empty((0, 3), dtype=float)
   446	        )
   447	        library = libraries[bridge_atoms]
   448	        target_distance = float(np.linalg.norm(finish - start))
   449	        errors = np.abs(library["distances"] - target_distance)
   450	        count = min(NEAREST_CONFORMERS, errors.size)
   451	        indices = np.argpartition(errors, count - 1)[:count]
   452	        indices = indices[np.argsort(errors[indices])]
   453	        feasible: list[dict[str, Any]] = []
   454	        best_failed: dict[str, Any] | None = None
   455	        tested = 0
   456	        for library_index in indices:
   457	            base_chain = library["chains"][int(library_index)]
   458	            for mirror in (False, True):
   459	                for azimuth in AZIMUTHS_DEG:
   460	                    tested += 1
   461	                    mapped = map_chain_generic(
   462	                        base_chain,
   463	                        start,
   464	                        finish,
   465	                        azimuth,
   466	                        mirror,
   467	                        geometry,
   468	                    )
   469	                    metrics = evaluate_chain(
   470	                        mapped,
   471	                        start_neighbors,
   472	                        finish_neighbors,
   473	                        local_fixed,
   474	                        geometry,
   475	                    )
   476	                    candidate = {
   477	                        "chain": mapped,
   478	                        "library_index": int(library_index),
   479	                        "library_distance_error_nm": float(errors[int(library_index)]),
   480	                        "mirror": mirror,
   481	                        "azimuth_deg": azimuth,
   482	                        **metrics,
   483	                    }
   484	                    if metrics["passes"]:
   485	                        feasible.append(candidate)
   486	                        if len(feasible) >= PAIR_PASS_TARGET:
   487	                            break
   488	                    elif best_failed is None or local_score(candidate) < local_score(best_failed):
   489	                        best_failed = candidate
   490	                if len(feasible) >= PAIR_PASS_TARGET:
   491	                    break
   492	            if len(feasible) >= PAIR_PASS_TARGET:
   493	                break
   494	        feasible.sort(key=local_score)
   495	        feasible = feasible[:PAIR_POOL_SIZE]
   496	        best = feasible[0] if feasible else best_failed
   497	        if best is None:
   498	            raise RuntimeError(f"No candidates tested for {key}")
   499	        result = {
   500	            "end": end,
   501	            "bridge_atoms": bridge_atoms,
   502	            "seed_node": seed_id,
   503	            "annulus_node": annulus_id,
   504	            "target_distance_nm": target_distance,
   505	            "local_fixed_heavy_atoms": len(local_ids),
   506	            "candidates_tested": tested,
   507	            "pair_feasible": bool(feasible),
   508	            "retained_feasible_candidates": len(feasible),
   509	            "best_library_distance_error_nm": float(best["library_distance_error_nm"]),
   510	            "best_minimum_angle_deg": float(best["minimum_angle_deg"]),
   511	            "best_maximum_angle_deg": float(best["maximum_angle_deg"]),
   512	            "best_maximum_bond_deviation_nm": float(best["maximum_bond_deviation_nm"]),
   513	            "best_minimum_clearance_nm": float(best["minimum_clearance_nm"]),
   514	            "best_angle_violations": int(best["angle_violations"]),
   515	            "best_clash_count": int(best["clash_count"]),
   516	            "pool": feasible,
   517	        }
   518	        pair_cache[key] = result
   519	        pair_rows.append({key: value for key, value in result.items() if key != "pool"})
   520	        return result
