   174	def build_library(bridge_atoms: int) -> dict[str, np.ndarray]:
   175	    rng = np.random.default_rng(35000 + bridge_atoms)
   176	    angles = np.deg2rad(
   177	        rng.uniform(
   178	            ANGLE_MIN_LIBRARY_DEG,
   179	            ANGLE_MAX_LIBRARY_DEG,
   180	            size=(LIBRARY_SAMPLES, bridge_atoms),
   181	        )
   182	    )
   183	    torsions = rng.uniform(
   184	        0.0,
   185	        2.0 * math.pi,
   186	        size=(LIBRARY_SAMPLES, bridge_atoms - 1),
   187	    )
   188	    p0 = np.zeros((LIBRARY_SAMPLES, 3), dtype=float)
   189	    p1 = np.tile(np.asarray([BN, 0.0, 0.0]), (LIBRARY_SAMPLES, 1))
   190	    p2 = p1 + BN * np.column_stack(
   191	        (-np.cos(angles[:, 0]), np.sin(angles[:, 0]), np.zeros(LIBRARY_SAMPLES))
   192	    )
   193	    points = [p0, p1, p2]
   194	    for index in range(1, bridge_atoms):
   195	        points.append(
   196	            place_next_batch(
   197	                points[-3],
   198	                points[-2],
   199	                points[-1],
   200	                angles[:, index],
   201	                torsions[:, index - 1],
   202	            )
   203	        )
   204	    chains = np.stack(points, axis=1)
   205	    distances = np.linalg.norm(chains[:, -1] - chains[:, 0], axis=1)
   206	    return {"chains": chains, "distances": distances}
