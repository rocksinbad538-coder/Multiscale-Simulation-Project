   522	    def refine_mapping(pair_results: list[dict[str, Any]]) -> dict[str, Any]:
   523	        if any(not result["pair_feasible"] for result in pair_results):
   524	            return {
   525	                "feasible": False,
   526	                "interbridge_clashes": -1,
   527	                "minimum_interbridge_clearance_nm": 0.0,
   528	                "minimum_angle_deg": min(float(result["best_minimum_angle_deg"]) for result in pair_results),
   529	                "maximum_bond_deviation_nm": max(float(result["best_maximum_bond_deviation_nm"]) for result in pair_results),
   530	                "minimum_local_clearance_nm": min(float(result["best_minimum_clearance_nm"]) for result in pair_results),
   531	                "indices": [],
   532	            }
   533	        indices = [0] * len(pair_results)
   534	        for sweep in range(GLOBAL_SWEEPS):
   535	            changed = 0
   536	            order = range(len(pair_results)) if sweep % 2 == 0 else reversed(range(len(pair_results)))
   537	            for path_index in order:
   538	                other_points = []
   539	                for other_index, result in enumerate(pair_results):
   540	                    if other_index != path_index:
   541	                        other_points.extend(result["pool"][indices[other_index]]["chain"][1:-1])
   542	                other_array = np.asarray(other_points, dtype=float)
   543	                scores = []
   544	                for candidate in pair_results[path_index]["pool"]:
   545	                    internal = candidate["chain"][1:-1]
   546	                    distances = np.linalg.norm(
   547	                        internal[:, None, :] - other_array[None, :, :],
   548	                        axis=2,
   549	                    ).reshape(-1)
   550	                    scores.append(
   551	                        (
   552	                            int(np.sum(distances < MIN_HEAVY_CLEARANCE_NM)),
   553	                            soft_penalty(distances),
   554	                            -min(float(candidate["minimum_clearance_nm"]), float(np.min(distances))),
   555	                            -float(candidate["minimum_angle_deg"]),
   556	                            float(candidate["maximum_bond_deviation_nm"]),
   557	                        )
   558	                    )
   559	                best_index = min(range(len(scores)), key=lambda index: scores[index])
   560	                if best_index != indices[path_index]:
   561	                    indices[path_index] = best_index
   562	                    changed += 1
   563	            if changed == 0:
   564	                break
   565	        inter_distances = []
   566	        for first in range(len(pair_results)):
   567	            first_points = pair_results[first]["pool"][indices[first]]["chain"][1:-1]
   568	            for second in range(first + 1, len(pair_results)):
   569	                second_points = pair_results[second]["pool"][indices[second]]["chain"][1:-1]
   570	                inter_distances.extend(
   571	                    np.linalg.norm(
   572	                        first_points[:, None, :] - second_points[None, :, :],
   573	                        axis=2,
   574	                    ).reshape(-1)
   575	                )
   576	        inter_values = np.asarray(inter_distances, dtype=float)
   577	        clashes = int(np.sum(inter_values < MIN_HEAVY_CLEARANCE_NM))
   578	        selected = [result["pool"][indices[index]] for index, result in enumerate(pair_results)]
   579	        return {
   580	            "feasible": clashes == 0,
   581	            "interbridge_clashes": clashes,
   582	            "minimum_interbridge_clearance_nm": float(np.min(inter_values)),
   583	            "minimum_angle_deg": min(float(candidate["minimum_angle_deg"]) for candidate in selected),
   584	            "maximum_bond_deviation_nm": max(float(candidate["maximum_bond_deviation_nm"]) for candidate in selected),
   585	            "minimum_local_clearance_nm": min(float(candidate["minimum_clearance_nm"]) for candidate in selected),
   586	            "indices": indices,
   587	        }
