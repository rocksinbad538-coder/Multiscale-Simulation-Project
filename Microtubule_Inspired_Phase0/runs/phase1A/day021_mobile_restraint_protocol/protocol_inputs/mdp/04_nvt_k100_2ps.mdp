; Day021 mobile-release protocol
; Derived from runs/phase1A/accepted/hybrid_hydrated_gap45_pyr5shift_clean032_nvt_100ps_frozenSolute/nvt_100ps_frozenSolute.mdp
; Accepted source files were not modified

integrator                   = md
dt                           = 0.0005
nsteps                       = 4000
nstxout-compressed           = 200
nstenergy                    = 200
nstlog                       = 200
cutoff-scheme                = Verlet
nstlist                      = 20
rlist                        = 1.2
coulombtype                  = PME
rcoulomb                     = 1.2
vdwtype                      = Cut-off
rvdw                         = 1.2
pbc                          = xyz
constraints                  = none
tcoupl                       = V-rescale
tc-grps                      = System
tau-t                        = 1.0
ref-t                        = 300
pcoupl                       = no
comm-mode                    = None
gen-vel                      = no
define                       = -DPOSRES_HBN_K100 -DPOSRES_PYR_K100
continuation                 = yes
nstxout                      = 0
nstvout                      = 0
nstfout                      = 0
nstcalcenergy                = 100
