; Day021 mobile-release protocol
; Derived from runs/phase1A/accepted/hybrid_hydrated_gap45_pyr5shift_clean032_nvt_100ps_frozenSolute/nvt_100ps_frozenSolute.mdp
; Accepted source files were not modified

integrator                   = md
dt                           = 0.0005
nsteps                       = 50000
nstxout-compressed           = 1000
nstenergy                    = 200
nstlog                       = 1000
cutoff-scheme                = Verlet
nstlist                      = 20
rlist                        = 1.2
coulombtype                  = PME
rcoulomb                     = 1.2
vdwtype                      = Cut-off
rvdw                         = 1.2
pbc                          = xyz
constraints                  = none
tcoupl                       = V-rescale
tc-grps                      = System
tau-t                        = 1.0
ref-t                        = 300
pcoupl                       = no
comm-mode                    = Linear
gen-vel                      = no
continuation                 = yes
comm-grps                    = System
nstcomm                      = 100
nstxout                      = 0
nstvout                      = 0
nstfout                      = 0
nstcalcenergy                = 100

; Day021 short unrestrained mobile validation
; 20000 steps x 0.0005 ps = 10 ps

; Day022 extended unrestrained mobile validation
; 50000 steps x 0.0005 ps = 25 ps
; compressed coordinates every 0.5 ps
