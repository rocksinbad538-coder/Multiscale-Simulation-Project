                        "annulus_node": outer_row["node_id"],
                        "selected_pool_index": int(pool_index),
                        "library_index": int(candidate["library_index"]),
                        "library_random_seed": 35000 + selected_m,
                        "library_distance_error_nm": float(
                            candidate["library_distance_error_nm"]
                        ),
                        "mirror": bool(candidate["mirror"]),
                        "azimuth_deg": float(candidate["azimuth_deg"]),
                        "minimum_angle_deg": float(
                            candidate["minimum_angle_deg"]
                        ),
                        "maximum_angle_deg": float(
                            candidate["maximum_angle_deg"]
                        ),
                        "maximum_bond_deviation_nm": float(
                            candidate["maximum_bond_deviation_nm"]
                        ),
                        "minimum_local_clearance_nm": float(
                            candidate["minimum_clearance_nm"]
                        ),
                        "local_clash_count": int(
                            candidate["clash_count"]
                        ),
