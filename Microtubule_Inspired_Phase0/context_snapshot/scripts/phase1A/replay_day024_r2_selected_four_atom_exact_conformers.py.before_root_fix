def require_file(path: Path) -> None:
    if (
        not path.is_file()
        or path.stat().st_size == 0
    ):
        raise RuntimeError(
            f"Missing or empty required file: {path}"
        )


def sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as handle:
        for chunk in iter(
            lambda: handle.read(1024 * 1024),
            b"",
        ):
            digest.update(chunk)

    return digest.hexdigest()


def relative(path: Path) -> str:
    return str(
        path.resolve().relative_to(ROOT)
    )


def read_rows(
    path: Path,
) -> list[dict[str, str]]:
    require_file(path)

    with path.open(
        newline="",
        encoding="utf-8",
    ) as handle:
        rows = list(
            csv.DictReader(handle)
        )

    if not rows:
        raise RuntimeError(
            f"No rows found in {path}"
        )

    return rows


def read_one(
    path: Path,
) -> dict[str, str]:
    rows = read_rows(path)

    if len(rows) != 1:
        raise RuntimeError(
            f"Expected one row in {path}; found {len(rows)}"
        )

    return rows[0]


def write_rows(
    path: Path,
    rows: list[dict[str, Any]],
) -> None:
    if not rows:
        raise RuntimeError(
            f"No rows available for {path}"
        )

    fields: list[str] = []

    for row in rows:
        for key in row:
            if key not in fields:
                fields.append(key)

    with path.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as handle:
        writer = csv.DictWriter(
            handle,
            fieldnames=fields,
        )

        writer.writeheader()

        for row in rows:
            writer.writerow(
                {
                    field: row.get(
                        field,
                        "",
                    )
                    for field in fields
                }
            )


def parse_bool(value: Any) -> bool:
    return str(value).strip().lower() in {
        "true",
        "yes",
        "1",
        "pass",
    }


def parse_float(
    row: dict[str, str],
    key: str,
) -> float:
    try:
        return float(row[key])
    except (
        KeyError,
        TypeError,
        ValueError,
    ) as exc:
        raise RuntimeError(
            f"Could not parse numeric field {key!r}"
        ) from exc


def compare_selected_rows(
    source_rows: list[dict[str, str]],
    replay_rows: list[dict[str, str]],
) -> tuple[
    bool,
    list[str],
]:
    source_mappings = {
        row["mapping_id"]: row
        for row in source_rows
        if row.get(
            "classification"
        )
        == "SELECTED_END_MAPPING"
    }

    replay_mappings = {
        row["mapping_id"]: row
        for row in replay_rows
        if row.get(
            "classification"
        )
        == "SELECTED_END_MAPPING"
    }

    differences: list[str] = []

    if set(source_mappings) != set(
        replay_mappings
    ):
        differences.append(
            "selected_mapping_identifiers_differ"
        )

        return False, differences

    exact_fields = (
        "bridge_atoms_per_attachment",
        "attachments_per_end",
        "end",
        "seed_element",
        "bridge_element_sequence",
        "annulus_endpoint_element",
        "seed_parity",
        "orientation",
        "rotation",
        "seed_nodes",
        "annulus_nodes",
    )

    numeric_fields = (
        "minimum_interbridge_clearance_nm",
        "minimum_angle_deg",
        "maximum_bond_deviation_nm",
        "minimum_local_clearance_nm",
    )

    for mapping_id in sorted(
        source_mappings
    ):
        source = source_mappings[
            mapping_id
        ]

        replay = replay_mappings[
            mapping_id
        ]

        for field in exact_fields:
            if source.get(
                field,
                ""
            ) != replay.get(
                field,
                ""
            ):
                differences.append(
                    f"{mapping_id}:{field}"
                )

        for field in numeric_fields:
            source_value = parse_float(
                source,
                field,
            )

            replay_value = parse_float(
                replay,
                field,
            )

            if abs(
                source_value
                - replay_value
            ) > 1.0e-12:
                differences.append(
                    f"{mapping_id}:{field}"
                )

    return (
        len(differences) == 0,
        differences,
    )


