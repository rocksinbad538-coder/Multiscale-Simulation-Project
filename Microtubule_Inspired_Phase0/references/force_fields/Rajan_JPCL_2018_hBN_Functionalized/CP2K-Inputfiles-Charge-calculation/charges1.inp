

&GLOBAL
  PROJECT HBN_Sheet
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QS #solving the electronic structure problem in order to calculate the forces on  atoms

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    RESTART_FILE_NAME sheet_only-RESTART.wfn
    
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      MAP_CONSISTENT
    &END QS

    &MGRID
      NGRIDS 4
      CUTOFF 450
      REL_CUTOFF 60
    &END MGRID

    &SCF #self-consistent field (SCF) calculation is performed in order to find the ground state energy of the system
      #SCF_GUESS ATOMIC
      SCF_GUESS RESTART
      EPS_SCF 1.0E-6
      MAX_SCF 150 #each step the potential is calculated from the electronic density,used to construct a new electron density by solving the KS equations 
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 15
      &END OUTER_SCF


      CHOLESKY INVERSE
   
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      
      &MIXING .TRUE.
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA  1.5
        NBUFFER 8
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 298.15
      &END SMEAR
      ADDED_MOS 50
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    
    &PRINT
      &V_HARTREE_CUBE ON
	FILENAME C1
      &END V_HARTREE_CUBE
    &END PRINT
    
    CHARGE 0
    MULTIPLICITY 1
    UNRESTRICTED_KOHN_SHAM

    &DENSITY_FITTING ON
    &END DENSITY_FITTING
  &END DFT
  
  &SUBSYS
    &CELL
      ABC [angstrom]  32.6495   34.8003648256739  20
      ALPHA_BETA_GAMMA 90. 90. 90.
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME hbn_Bedge_36H_opt.xyz
    &END TOPOLOGY
    &KIND B
      BASIS_SET DZVP-MOLOPT-SR-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-SR-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND H
      BASIS_SET TZV2P-MOLOPT-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
     &END SUBSYS
  
  &PROPERTIES
    &FIT_CHARGE ON
    &END FIT_CHARGE
  &END PROPERTIES

&END FORCE_EVAL
